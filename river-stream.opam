depends: [
  "dune" {>= "3.0"}
  "fit"
  "ocaml"
  "cmdliner"
  "angstrom"
  "yojson"
  "ptime"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lindig/river-stream.git"
pin-depends: [
  ["fit.~dev" "git+https://github.com/lindig/fit.git#main"]
